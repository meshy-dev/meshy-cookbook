# Copy this file to .env and fill it in. Never commit .env.

# Meshy API key: https://www.meshy.ai/developers/keys
# Under npm run dev you can leave it empty and sign in with the Meshy CLI
# instead, from API keys in the app.
MESHY_API_KEY=

# The server spends MESHY_API_KEY only when this is true. Set it to true on
# your own machine. On a public deploy it lets every visitor spend your
# credits; leave it empty there and visitors add their own key in the app.
ALLOW_SERVER_MESHY=

# Optional: a Vercel AI Gateway key for the chat director,
# https://vercel.com/ai-gateway. Every control works without it.
AI_GATEWAY_API_KEY=

# The server spends AI_GATEWAY_API_KEY only when this is true. Same rule as
# ALLOW_SERVER_MESHY.
ALLOW_SERVER_CHAT=

# Optional: any AI Gateway model id for the director.
# AGENT_MODEL=anthropic/claude-sonnet-5.5
