# Copy this file to .env and fill it in. Never commit .env.

# Meshy API key: https://www.meshy.ai/developers/keys
# Under npm run dev you can leave it empty and sign in with the Meshy CLI
# instead, from API keys in the app.
MESHY_API_KEY=

# The server spends MESHY_API_KEY only when this is true. Set it to true on
# your own machine. On a public deploy it lets every visitor spend your
# credits; leave it empty there and visitors add their own key in the app.
ALLOW_SERVER_MESHY=

# Optional, for the chat director: an Anthropic API key, which runs it on
# Claude directly (https://platform.claude.com/settings/keys), or a Vercel AI
# Gateway key (https://vercel.com/ai-gateway). With both, the Anthropic key is
# used. Every control works without them.
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=

# The server spends these keys only when this is true. Same rule as
# ALLOW_SERVER_MESHY.
ALLOW_SERVER_CHAT=

# Optional: the director's model, for an Anthropic key and for AI Gateway.
# AGENT_ANTHROPIC_MODEL=claude-sonnet-5-5
# AGENT_MODEL=anthropic/claude-sonnet-5.5
