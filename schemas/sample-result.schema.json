{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recorded Meshy cookbook sample result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slug", "historical_run", "artifact_inspection"],
  "properties": {
    "schema_version": {"const": 1},
    "slug": {"type": "string", "minLength": 1},
    "historical_run": {
      "type": "object", "additionalProperties": false,
      "required": ["documented_on", "source", "credits", "model", "note"],
      "properties": {
        "documented_on": {"type": "string", "format": "date"},
        "source": {"const": "README.md"},
        "credits": {"type": "number", "minimum": 0},
        "model": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "artifact_inspection": {
      "type": "object", "additionalProperties": false,
      "required": ["inspected_on", "method", "note", "artifacts"],
      "properties": {
        "inspected_on": {"type": "string", "format": "date"},
        "method": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1},
        "artifacts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["filename", "format", "bytes", "sha256"],
            "properties": {
              "filename": {"type": "string", "pattern": "^[^/\\\\]+$"},
              "format": {"enum": ["glb", "usdz", "3mf"]},
              "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "triangles": {"type": "integer", "minimum": 0},
              "vertices": {"type": "integer", "minimum": 0},
              "meshes": {"type": "integer", "minimum": 0},
              "materials": {"type": "integer", "minimum": 0},
              "embedded_images": {"type": "integer", "minimum": 0},
              "skins": {"type": "integer", "minimum": 0},
              "animations": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
