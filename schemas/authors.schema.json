{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meshy cookbook authors",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {"$ref": "#/$defs/github_username"},
  "additionalProperties": {
    "type": "object", "additionalProperties": false, "required": ["name", "website", "avatar"],
    "properties": {
      "name": {"type": "string", "minLength": 1},
      "website": {"type": "string", "format": "uri", "pattern": "^https://"},
      "avatar": {"type": "string", "format": "uri", "pattern": "^https://"}
    }
  },
  "$defs": {
    "github_username": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"}
  }
}
